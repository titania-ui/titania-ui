{
	"name": "@titania/ui",
	"version": "0.0.4",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme/base.css": {
			"default": "./dist/theme/base.css"
		},
		"./theme/flowbite.css": {
			"default": "./dist/theme/flowbite/index.css"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"peerDependencies": {
		"bits-ui": "^2.18.0",
		"svelte": "^5.2.0",
		"sveltekit-superforms": "^2.0.0",
		"tailwind-variants": "3.2.0",
		"tailwindcss": "^4.3.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify/json": "^2.2.541",
		"@iconify/tailwind4": "^1.2.3",
		"@playwright/test": "1.61.1",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.6.1",
		"@storybook/sveltekit": "^10.6.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"bits-ui": "^2.19.5",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.1",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "1.61.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"storybook": "^10.6.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-variants": "3.2.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1",
		"zod": "^4.6.5"
	},
	"keywords": [
		"svelte",
		"ui",
		"components",
		"tailwind"
	],
	"dependencies": {
		"svelte-toolbelt": "^0.10.6"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/titania-ui/titania-ui.git",
		"directory": "packages/ui"
	}
}
